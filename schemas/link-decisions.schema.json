{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "link-decisions.schema.json",
  "title": "Link Decision Record (one NDJSON line)",
  "description": "Append-only decision log for the Jev link-graph pipeline. One JSON object per line.",
  "type": "object",
  "required": [
    "decision_id",
    "ts",
    "source_url",
    "passage_id",
    "candidates",
    "choice",
    "confidence",
    "probabilities",
    "action",
    "model"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string", "format": "uri" },
    "passage_id": { "type": "string", "minLength": 1 },
    "heading": { "type": ["string", "null"] },
    "passage": { "type": ["string", "null"] },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "url", "title"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "choice": {
      "type": "string",
      "description": "Selected candidate id or the literal no_link"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "probabilities": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "anchor_already_present": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Noul probability that natural anchor text already exists"
    },
    "action": {
      "type": "string",
      "enum": ["auto", "review", "refuse"]
    },
    "model": { "type": "string", "minLength": 1 },
    "money_page": { "type": "boolean", "default": false },
    "target_url": { "type": ["string", "null"], "format": "uri" },
    "suggested_anchor": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
