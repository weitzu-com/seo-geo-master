{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content-queue.schema.json",
  "title": "Content Queue",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "site_url": { "type": "string", "format": "uri" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "primary_keyword"],
        "properties": {
          "id": { "type": "string", "pattern": "^cq-[0-9]{3}$" },
          "status": { "type": "string", "enum": ["queued", "in_progress", "written", "needs_review", "skipped", "published"] },
          "primary_keyword": { "type": "string", "minLength": 1 },
          "keyword_volume": { "type": "integer", "minimum": 0 },
          "keyword_difficulty": { "type": "integer", "minimum": 0, "maximum": 100 },
          "intent": { "type": "string", "enum": ["informational", "commercial", "transactional", "navigational"] },
          "target_url_slug": { "type": "string" },
          "wp_category_ids": { "type": "array", "items": { "type": "integer" } },
          "wp_post_id": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
